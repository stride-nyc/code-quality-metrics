
# Dolt database files (added by bd init)
.dolt/
*.db

# Beads task tracking (exclude binary dolt database, keep audit trail)
.beads/*
!.beads/issues.jsonl
!.beads/config.yaml

# Environment variables — never commit API keys
.env
.env.local

# Generated output files
# .codemetrics/ (code-quality-metrics-w3wn) is local-code-metrics.js's own default output
# directory. The two local_* patterns below already matched every file that ever landed
# inside it by name alone (this line predates the directory), but the directory is named
# explicitly here too: it is the canonical location this project's README/CLAUDE.md tell
# every other target repository to add to their own .gitignore, so this repository's own
# ignore file should show the same pattern, not rely on a name-based coincidence.
.codemetrics/
local_*.json
local_*.html
demo/*.txt
temp/*
RETROSPECTIVE*.md

# Test coverage
coverage/
node_modules/

# macOS
.DS_Store

# Claude Code local state
# settings.local.json is per-developer; worktrees/ holds ephemeral agent
# checkouts of this same repo. A shared .claude/settings.json or .claude/agents/
# is still committable, so this is deliberately not a blanket .claude/ ignore.
.claude/settings.local.json
.claude/worktrees/
