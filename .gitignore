
# Dolt database files (added by bd init)
.dolt/
*.db

# Beads task tracking (exclude binary dolt database, keep audit trail)
.beads/*
!.beads/issues.jsonl
!.beads/config.yaml

# Environment variables — never commit API keys
.env
.env.local

# Generated output files
local_*.json
local_*.html
demo/*.txt
temp/*
RETROSPECTIVE*.md

# Test coverage
coverage/
node_modules/

# macOS
.DS_Store

# Claude Code local state
# settings.local.json is per-developer; worktrees/ holds ephemeral agent
# checkouts of this same repo. A shared .claude/settings.json or .claude/agents/
# is still committable, so this is deliberately not a blanket .claude/ ignore.
.claude/settings.local.json
.claude/worktrees/
